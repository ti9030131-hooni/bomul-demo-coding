{
  "redirects": [
    {
      "source": "/courses",
      "destination": "/bomul.html?go=courses",
      "permanent": false
    },
    {
      "source": "/courses/:id",
      "destination": "/bomul.html?go=course-:id",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bomul-backend-ee5313fb7ed6.herokuapp.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

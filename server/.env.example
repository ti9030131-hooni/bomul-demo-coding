PORT=4000
# 배포된 사이트 주소. 여러 개면 쉼표로 구분합니다.
# Vercel 무료 테스트는 Environment Variables에도 같은 값을 넣습니다.
CLIENT_ORIGIN=https://bomul-demo-vercel.vercel.app
# 네이버 로그인 후 돌아갈 화면 주소
CLIENT_URL=http://localhost:5173
# MongoDB Atlas 주소. 값이 있으면 이 주소를 쓰고, 비어 있을 때만 로컬을 씁니다.
MONGO_ATLAS_URL=
# localhost는 IPv6(::1)로 해석돼 연결이 거부될 수 있으므로 127.0.0.1 사용
MONGODB_URI=mongodb://127.0.0.1:27017/coding-bomul
# 로그인 토큰 서명에 사용. 긴 무작위 문자열로 바꾸세요.
JWT_SECRET=replace-with-a-long-random-string
# 네이버 개발자센터(https://developers.naver.com/apps)에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 구글 클라우드 콘솔에서 OAuth 클라이언트를 만든 뒤 발급
# 승인된 리디렉션: http://localhost:4000/api/login/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudinary 업로드 위젯. API Secret은 넣지 않습니다.
# 클라우드 이름: https://console.cloudinary.com/settings/account
# Upload preset: https://console.cloudinary.com/settings/upload 에서 Signing Mode를 Unsigned로 만든 이름
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# 결제·도전권 구매. 0 이면 주문/멤버십 POST 차단(사이트 나머지 기능은 유지).
# 미설정 시 NODE_ENV=production 이면 차단, 로컬 개발은 허용.
PAYMENTS_ENABLED=0
# 포트원 REST API (결제 금액·주문번호·상태 서버 검증)
# PORTONE_MODE=mock | live | off (운영에서 mock 은 ALLOW_MOCK_PAY=1 없으면 off)
PORTONE_MODE=off
PORTONE_IMP_KEY=
PORTONE_IMP_SECRET=
# ALLOW_MOCK_PAY=1

